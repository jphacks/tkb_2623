# ローカルで Edge Function を動かすときの Secret のひな形。
# このファイルを同じフォルダに .env.local という名前でコピーし、値を入れる（.env.local は git に上がらない）。
# 本番の値はダッシュボードの Edge Functions > Secrets に登録する。

# Google AI Studio（https://aistudio.google.com/）で発行した Gemini API キー
GEMINI_API_KEY=your-gemini-api-key

# 使う Gemini のモデル（空なら gemini.ts の DEFAULT_MODEL）
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Webhook と Edge Function で共有する合言葉（推測されにくい長いランダム文字列）
ANALYZE_DISH_WEBHOOK_SECRET=your-webhook-secret
